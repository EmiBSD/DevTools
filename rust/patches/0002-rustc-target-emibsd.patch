rustc: the target aarch64-emibsd-emibsd

Why a patch: rustc knows nothing of EmiBSD, and DevTools' rustc emits for
aarch64-emibsd-emibsd (D-0004): the OS `emibsd` in rustc_target's Os enum,
a base `spec/base/emibsd.rs` stating what the ABI asks of the target, which
is the ABI its kernel and libc present (a dynamic system of PIE executables,
emulated TLS because its run-time link-editor has no ELF TLS, full RELRO,
frame pointers kept, structs returned as integers, +crt-static honoured as a
static PIE), the vendor `emibsd`, and
the target `aarch64-emibsd-emibsd` whose LLVM triple carries the release the
ABI belongs to, aarch64-emibsd-emibsd8.0 (the name of the target does not,
as x86_64-unknown-freebsd does not); rustdoc names the OS "EmiBSD" in
the documentation's cfg notes. Tier 3 by upstream's rules. Written by
EmiBSD (ISC); carried by DevTools over the pinned tag, offered upstream when
stable. Author: Emilio Navarrete Lineros, 2026-10-31.

--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/emibsd.rs
@@ -0,0 +1,25 @@
+use crate::spec::{FramePointer, Os, RelroLevel, TargetOptions, TlsModel, cvs};
+
+/// EmiBSD: the ABI its kernel and libc present, which is OpenBSD's (D-0003 of DevTools:
+/// written from the ABI, not copied); a dynamic system whose executables are PIE, with no
+/// ELF TLS in its run-time link-editor (emulated TLS), full RELRO, frame pointers kept for
+/// the kernel's and ld.so's backtraces.
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::EmiBsd,
+        vendor: "emibsd".into(),
+        dynamic_linking: true,
+        families: cvs!["unix"],
+        has_rpath: true,
+        abi_return_struct_as_int: true,
+        position_independent_executables: true,
+        // +crt-static gives a static PIE (rcrt0.o): rustc asks the driver for -static-pie.
+        crt_static_respected: true,
+        static_position_independent_executables: true,
+        frame_pointer: FramePointer::Always,
+        relro_level: RelroLevel::Full,
+        default_dwarf_version: 2,
+        tls_model: TlsModel::Emulated,
+        ..Default::default()
+    }
+}
