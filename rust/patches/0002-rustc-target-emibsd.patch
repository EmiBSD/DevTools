--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/aarch64_emibsd_emibsd.rs
@@ -0,0 +1,23 @@
+use crate::spec::{Arch, StackProbeType, Target, TargetMetadata, TargetOptions, base};
+
+pub(crate) fn target() -> Target {
+    Target {
+        // The LLVM triple carries the EmiBSD release the ABI belongs to; the target's name does not.
+        llvm_target: "aarch64-emibsd-emibsd8.0".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 EmiBSD 8.0".into()),
+            tier: Some(3),
+            host_tools: Some(true),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32".into(),
+        arch: Arch::AArch64,
+        options: TargetOptions {
+            features: "+v8a".into(),
+            max_atomic_width: Some(128),
+            stack_probes: StackProbeType::Inline,
+            ..base::emibsd::opts()
+        },
+    }
+}
