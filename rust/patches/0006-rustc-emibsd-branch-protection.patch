     pub fn branch_protection(&self) -> Option<BranchProtection> {
         let mut bp = self.opts.unstable_opts.branch_protection;
 
+        // EmiBSD's kernel enforces branch target identification on every executable page of a
+        // process, and its C is compiled with BTI and non-leaf return address signing (key A):
+        // unless the option says otherwise, so is Rust for it.
+        if bp.is_none() && self.target.os == Os::EmiBsd && self.target.arch == Arch::AArch64 {
+            bp = Some(BranchProtection {
+                bti: true,
+                pac_ret: Some(config::PacRet { leaf: false, pc: false, key: PAuthKey::A }),
+                gcs: false,
+            });
+        }
+
         if let Some(bp) = bp.as_mut() {
             // Windows on Arm only supports PAC Key B for return address signing, as shown in
             // https://github.com/llvm/llvm-project/pull/203989. We parse the CLI flags for branch
@@ -1016,6 +1027,29 @@
         bp
     }
 
+    /// Returns the `-Zcf-protection` setting, adjusted to the current target: EmiBSD's kernel
+    /// enforces indirect branch tracking on x86_64, and its C is compiled with it, so branch
+    /// protection is what "none" means there.
+    pub fn cf_protection(&self) -> config::CFProtection {
+        let cf = self.opts.unstable_opts.cf_protection;
+        if cf == config::CFProtection::None && self.emibsd_ibt() {
+            config::CFProtection::Branch
+        } else {
+            cf
+        }
+    }
+
+    /// Whether `-Cjump-tables` holds on the current target. Under EmiBSD's indirect branch
+    /// tracking a jump table would jump indirectly to labels with no `endbr64`, so there are
+    /// none on x86_64, as in its C.
+    pub fn jump_tables(&self) -> bool {
+        self.opts.cg.jump_tables && !self.emibsd_ibt()
+    }
+
+    fn emibsd_ibt(&self) -> bool {
+        self.target.os == Os::EmiBsd && self.target.arch == Arch::X86_64
+    }
+
