llvm: EmiBSD as vendor and operating system in the target triple

Why a patch: LLVM knows nothing of EmiBSD, and DevTools' toolchains emit for
aarch64-emibsd-emibsd8.0 and x86_64-emibsd-emibsd8.0 (D-0008; the OS version is the
release the ABI belongs to, set by the build glue, not by this patch): the vendor is
EmiBSD, the project (emibsd.org), and so is the operating system. This adds the
vendor (`emibsd`, Triple::EmiBSDVendor: the enumerators of VendorType and
OSType share Triple's scope, as Mesa and Mesa3D do) and the OS (`emibsd`,
Triple::EmiBSD, isOSEmiBSD) to the triple, and states what the ABI
needs of code generation, which is the ABI its kernel and libc present:
- emulated TLS by default: the run-time link-editor has no ELF TLS;
- the stack protector through the libc's __guard_local and
  __stack_smash_handler (RuntimeLibcalls.td's predicates, named for OpenBSD
  upstream, hold for EmiBSD too: the libc ABI is the same);
- the ELF OS/ABI byte 12 in objects: the value the kernel and ld.so recognise,
  on which lld keys the PT_OPENBSD_RANDOMIZE, _MUTABLE and _SYSCALLS segments.
Written by EmiBSD (ISC); carried by DevTools over the pinned tag, offered
upstream when stable. Author: Emilio Navarrete Lineros, 2026-10-31.

--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -295,13 +295,15 @@
     OpenEmbedded,
     Intel,
     Meta,
-    LastVendorType = Meta
+    EmiBSDVendor,
+    LastVendorType = EmiBSDVendor
   };
   enum OSType {
     UnknownOS,
 
     Darwin,
     DragonFly,
+    EmiBSD,
     FreeBSD,
     Fuchsia,
     IOS,
@@ -743,6 +745,7 @@
   bool isOSNetBSD() const { return getOS() == Triple::NetBSD; }
 
   bool isOSOpenBSD() const { return getOS() == Triple::OpenBSD; }
+  bool isOSEmiBSD() const { return getOS() == Triple::EmiBSD; }
 
   bool isOSFreeBSD() const { return getOS() == Triple::FreeBSD; }
 
@@ -1275,7 +1278,7 @@
   /// Note: Android API level 29 (10) introduced ELF TLS.
   bool hasDefaultEmulatedTLS() const {
     return (isAndroid() && isAndroidVersionLT(29)) || isOSOpenBSD() ||
-           isWindowsCygwinEnvironment() || isOHOSFamily();
+           isOSEmiBSD() || isWindowsCygwinEnvironment() || isOHOSFamily();
   }
 
   /// True if the target uses TLSDESC by default.
--- a/llvm/include/llvm/TargetParser/TripleName.def
+++ b/llvm/include/llvm/TargetParser/TripleName.def
@@ -31,6 +31,7 @@
 
 TRIPLE_OS(Darwin, "darwin")
 TRIPLE_OS(DragonFly, "dragonfly")
+TRIPLE_OS(EmiBSD, "emibsd")
 TRIPLE_OS(FreeBSD, "freebsd")
 TRIPLE_OS(Fuchsia, "fuchsia")
 TRIPLE_OS(IOS, "ios")
@@ -193,6 +194,7 @@
 TRIPLE_VENDOR_ALIAS(SCEI, "sie")
 TRIPLE_VENDOR(SUSE, "suse")
 TRIPLE_VENDOR(Meta, "meta")
+TRIPLE_VENDOR(EmiBSDVendor, "emibsd")
 
 #undef TRIPLE_VENDOR
 #undef TRIPLE_VENDOR_ALIAS
--- a/llvm/include/llvm/IR/RuntimeLibcalls.td
+++ b/llvm/include/llvm/IR/RuntimeLibcalls.td
@@ -17,8 +17,10 @@
 
 /// Libcall Predicates
 def isOSDarwin : RuntimeLibcallPredicate<"TT.isOSDarwin()">;
-def isOSOpenBSD : RuntimeLibcallPredicate<"TT.isOSOpenBSD()">;
-def isNotOSOpenBSD : RuntimeLibcallPredicate<"!TT.isOSOpenBSD()">;
+// EmiBSD shares the libc stack protector ABI of OpenBSD: the predicates named for
+// OpenBSD hold for both.
+def isOSOpenBSD : RuntimeLibcallPredicate<"TT.isOSOpenBSD() || TT.isOSEmiBSD()">;
+def isNotOSOpenBSD : RuntimeLibcallPredicate<"!TT.isOSOpenBSD() && !TT.isOSEmiBSD()">;
 def isOSWindows : RuntimeLibcallPredicate<"TT.isOSWindows()">;
 def isNotOSWindows : RuntimeLibcallPredicate<"!TT.isOSWindows()">;
 def isNotOSLinux : RuntimeLibcallPredicate<[{!TT.isOSLinux()}]>;
@@ -32,10 +34,10 @@
   [{TT.isWindowsMSVCEnvironment()}]>;
 
 def isNotOSLinuxAndNotOSOpenBSD : RuntimeLibcallPredicate<
-  [{!TT.isOSLinux() && !TT.isOSOpenBSD()}]>;
+  [{!TT.isOSLinux() && !TT.isOSOpenBSD() && !TT.isOSEmiBSD()}]>;
 
 def isNotOSAIXAndNotOSOpenBSD : RuntimeLibcallPredicate<
-  [{!TT.isOSAIX() && !TT.isOSOpenBSD()}]>;
+  [{!TT.isOSAIX() && !TT.isOSOpenBSD() && !TT.isOSEmiBSD()}]>;
 
 def isNotPS : RuntimeLibcallPredicate<
   [{!TT.isPS()}]>;
@@ -43,7 +45,7 @@
 // OpenBSD uses __guard_local. AIX uses __ssp_canary_word, MSVC/Windows
 // Itanium uses __security_cookie
 def hasStackChkFail : RuntimeLibcallPredicate<
-  [{ !TT.isOSOpenBSD() && !TT.isWindowsMSVCEnvironment() &&
+  [{ !TT.isOSOpenBSD() && !TT.isOSEmiBSD() && !TT.isWindowsMSVCEnvironment() &&
      !TT.isWindowsItaniumEnvironment()}]>;
 
 def isWindowsMSVCOrItaniumEnvironment : RuntimeLibcallPredicate<
--- a/llvm/include/llvm/MC/MCELFObjectWriter.h
+++ b/llvm/include/llvm/MC/MCELFObjectWriter.h
@@ -80,6 +80,10 @@
         return ELF::ELFOSABI_SOLARIS;
       case Triple::OpenBSD:
         return ELF::ELFOSABI_OPENBSD;
+      case Triple::EmiBSD:
+        // EmiBSD keeps the ELF ABI its kernel and ld.so recognise by this byte
+        // (the PT_OPENBSD_* segments lld emits for it are keyed on it).
+        return ELF::ELFOSABI_OPENBSD;
       default:
         return ELF::ELFOSABI_NONE;
     }
